generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  name      String
  status    String   @default("DISCONNECTED")
  config    String?  @db.Text
  userId    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Rule {
  id                Int           @id @default(autoincrement())
  name              String
  triggerType       String
  triggerValue      String
  actionType        String
  apiUrl            String?
  apiMethod         String?       @default("POST")
  apiPayload        String?       @db.Text
  responseContent   String?       @db.Text
  responseMediaType String?       @default("TEXT")
  responseMediaUrl  String?
  isActive          Boolean       @default(true)
  sessionId         String? // Optional, if null it applies to all sessions
  filterGroupId     String? // Optional: Specific Group JID
  credentialId      Int?
  credential        AiCredential? @relation(fields: [credentialId], references: [id])
  miniAppId         String?       // ID mini app yang diaktifkan (untuk actionType ACTIVATE_MINI_APP)
  userId            Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id])
}

// Mini App yang dibuat secara dinamis oleh user via dashboard
model MiniApp {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  icon            String   @default("🤖")
  category        String   @default("General")
  color           String   @default("#6366f1")
  version         String   @default("1.0.0")
  author          String   @default("Custom")
  // KEYWORD | VOICE_APP | KEYWORD_THEN_VOICE
  triggerType     String   @default("KEYWORD")
  // JSON array of keywords, e.g. ["!zakat","zakat"]
  triggerKeywords String   @db.Text @default("[]")
  systemPrompt    String?  @db.Text // AI system prompt (null untuk static apps = pakai default engine)
  referenceText   String?  @db.Text // Teks referensi custom (misal: teks Al-Fatiha, materi hukum, dll)
  activationMsg   String?  @db.Text // Pesan saat keyword aktifkan session
  requiresApiKey  Boolean  @default(true)
  showProcessing  Boolean  @default(true)
  // Handler type: DYNAMIC = pakai DynamicHandler, lainnya = filesystem handler
  handlerType     String   @default("DYNAMIC") // DYNAMIC | TAJWID_CHECKER | ZAKAT_CALCULATOR
  isActive        Boolean  @default(true)
  userId          Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}


model Schedule {
  id             Int           @id @default(autoincrement())
  sessionId      String
  recipient      String
  messageType    String
  content        String        @db.Text
  mediaUrl       String?
  actionType     String        @default("TEXT") // TEXT, IMAGE, AI_REPLY, API_CALL
  apiUrl         String?
  apiMethod      String?       @default("GET")
  apiPayload     String?       @db.Text
  credentialId   Int?
  credential     AiCredential? @relation(fields: [credentialId], references: [id])
  cronExpression String
  lastRun        DateTime?
  isActive       Boolean       @default(true)
  userId         Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id])
  logs           ScheduleLog[]
}

model ScheduleLog {
  id           Int      @id @default(autoincrement())
  scheduleId   Int
  status       String   // SUCCESS, FAILED
  errorMessage String?  @db.Text
  executedAt   DateTime @default(now())
  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model MessageLog {
  id        Int      @id @default(autoincrement())
  sessionId String
  direction String
  from      String
  to        String
  content   String   @db.Text
  status    String
  createdAt DateTime @default(now())
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  tags      String?
  userId    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, phone])
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  email         String?        @unique
  phone         String?
  password      String?        // nullable untuk Google-only users
  googleId      String?        @unique // Google OAuth UID
  googleEmail   String?        // Email dari Google
  googleAvatar  String?        // Avatar URL dari Google
  role          String         @default("USER")
  credits       Int            @default(0)
  planType      String         @default("PAY_AS_YOU_GO")
  planExpiresAt DateTime?
  messageCost   Int            @default(1)
  aiApiKey      String?
  aiProvider    String         @default("openai") // openai, gemini
  aiModel       String? // e.g. gemini-1.5-flash, gpt-4
  aiBriefing    String?        @db.Text
  isAiEnabled    Boolean        @default(false)
  isImageEnabled Boolean        @default(true)
  aiImageProvider String        @default("hercai") // openai, hercai, pollinations, gemini
  aiImageApiKey  String?        @db.Text
  isSchedulerEnabled Boolean    @default(true)
  isAutoRetryEnabled Boolean    @default(true)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  contacts      Contact[]
  rules         Rule[]
  schedules     Schedule[]
  sessions      Session[]
  broadcasts    Broadcast[]
  aiTools       AiTool[]
  credentials   AiCredential[]
  games         Game[]
  notes         Note[]
  telegramBots  TelegramBot[]
  userApps      UserApp[]
  miniApps      MiniApp[]
}

model TelegramBot {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  token     String   @unique
  username  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Broadcast {
  id           Int            @id @default(autoincrement())
  sessionId    String
  name         String? // e.g. "Campaign #1"
  tag          String
  messageType  String
  content      String         @db.Text
  mediaUrl     String?
  actionType   String         @default("TEXT") // TEXT, IMAGE, AI_REPLY, API_CALL
  apiUrl       String?
  apiMethod    String?        @default("GET")
  apiPayload   String?        @db.Text
  credentialId Int?
  credential   AiCredential?  @relation(fields: [credentialId], references: [id])
  total        Int            @default(0)
  sent         Int            @default(0)
  failed       Int            @default(0)
  status       String         @default("PROCESSING") // PROCESSING, COMPLETED
  userId       Int
  user         User           @relation(fields: [userId], references: [id])
  cratedAt     DateTime       @default(now())
  logs         BroadcastLog[]
}

model BroadcastLog {
  id           Int       @id @default(autoincrement())
  broadcastId  Int
  contactName  String?
  contactPhone String
  status       String // PENDING, SUCCESS, FAILED
  errorMessage String?
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id])
  createdAt    DateTime  @default(now())
}

model AiTool {
  id                 Int     @id @default(autoincrement())
  name               String  @unique
  description        String
  method             String  @default("GET")
  baseUrl            String
  endpoint           String
  parameters         String  @db.Text // Stored as JSON string
  headers            String? @db.Text // Stored as JSON string
  body               String? @db.Text // Stored as JSON string
  authType           String  @default("NONE") // NONE, API_KEY, BEARER
  authRefreshUrl     String? // URL to fetch new token (POST)
  authRefreshPayload String? @db.Text // JSON body for refresh (client_id, secret, etc)
  authTokenPath      String? // JSON path to find token in response (e.g. "access_token" or "data.token")

  credentialId Int?
  credential   AiCredential? @relation(fields: [credentialId], references: [id])

  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @default(1)
}

model AiCredential {
  id       Int     @id @default(autoincrement())
  name     String
  type     String  @default("API_KEY") // API_KEY, BEARER
  key      String? // e.g. "X-API-KEY", empty for Bearer
  value    String // The secret token
  location String  @default("HEADER") // HEADER, QUERY

  // Auto-Refresh Logic
  refreshUrl      String?
  refreshPayload  String?   @db.Text
  tokenPath       String?
  refreshInterval Int? // In minutes
  lastRefreshed   DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  tools      AiTool[]
  rules      Rule[]
  schedules  Schedule[]
  broadcasts Broadcast[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Game {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  trigger   String   @unique
  type      String // TRIVIA, AI_RPG, GUESS_NUMBER
  config    String   @db.Text
  reward    Int      @default(10)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  activeGames ActiveGame[]
}

model ActiveGame {
  id          Int      @id @default(autoincrement())
  gameId      Int
  playerPhone String
  sessionId   String
  state       String   @db.Text
  startedAt   DateTime @default(now())
  lastActive  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id])

  @@unique([playerPhone])
}

model Note {
  id        Int      @id @default(autoincrement())
  userId    Int
  keyword   String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, keyword])
}

/// Menyimpan status enable/disable setiap Mini App per user
model UserApp {
  id        Int      @id @default(autoincrement())
  userId    Int
  appId     String   // ID app dari APP_CATALOG, e.g. 'tajwid-checker'
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, appId])
}

model AiModel {
  id        Int      @id @default(autoincrement())
  provider  String
  value     String
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
